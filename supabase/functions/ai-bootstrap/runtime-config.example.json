{
  "configVersion": 1,
  "defaultOption": "balanced",
  "ttlSeconds": 604800,
  "providers": [
    {
      "id": "deepseek",
      "protocol": "openai_compatible_chat",
      "baseUrl": "https://api.deepseek.com",
      "credentialVersion": 1,
      "credentialEnv": "AI_PROVIDER_DEEPSEEK_KEY"
    }
  ],
  "options": [
    {
      "id": "balanced",
      "name": "均衡",
      "maxOutputTokens": 2400,
      "targets": [
        {
          "providerId": "deepseek",
          "model": "deepseek-v4-flash",
          "priority": 0
        }
      ]
    },
    {
      "id": "deep",
      "name": "深度",
      "maxOutputTokens": 4000,
      "targets": [
        {
          "providerId": "deepseek",
          "model": "deepseek-v4-pro",
          "priority": 0
        }
      ]
    }
  ]
}
